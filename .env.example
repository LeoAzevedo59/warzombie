# Copie para .env (usado pelo docker compose e pelo server em dev)
POSTGRES_USER=warzombie
POSTGRES_PASSWORD=warzombie
POSTGRES_DB=warzombie
POSTGRES_PORT=5434

# URL usada pelo Prisma (server). Em dev local aponte para o Postgres do compose:
DATABASE_URL=postgresql://warzombie:warzombie@localhost:5434/warzombie?schema=public

PORT=3000
# Tick de broadcast do estado dos jogadores (Hz)
WS_TICK_RATE=20
