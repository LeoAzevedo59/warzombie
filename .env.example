# Copie para .env e preencha. O .env NUNCA é versionado (está no .gitignore).
# Nenhum valor real de produção deve ser escrito em arquivos do repositório.
POSTGRES_USER=warzombie
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=warzombie
# Porta do Postgres no host (5432/5433 costumam estar ocupadas)
POSTGRES_PORT=5434

# URL usada pelo Prisma fora do Docker (dev local). Mantenha igual aos valores acima.
DATABASE_URL=postgresql://warzombie:troque-esta-senha@localhost:5434/warzombie?schema=public

PORT=3000
# Tick de broadcast do estado dos jogadores (Hz)
WS_TICK_RATE=20
# Painel ⚙ de cheats no jogo (dinheiro, itens, dano, pular wave). 1 só em ambiente de teste.
DEV_CHEATS=0
