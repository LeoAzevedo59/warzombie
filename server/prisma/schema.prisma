// Fonte única da verdade do banco. Fluxo: editar aqui -> `npm run db:migrate -- --name <desc>`
// -> SQL versionado em prisma/migrations -> `prisma migrate deploy` aplica em qualquer ambiente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Jogador identificado apenas pelo nome (passo 1: sem senha/conta).
/// Estado persistido é o último conhecido; atualizado ao desconectar e periodicamente.
model Player {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(16)
  /// nome normalizado (lowercase/trim) para unicidade sem diferenciar maiúsculas
  nameKey   String   @unique @map("name_key") @db.VarChar(16)
  hp        Int      @default(100)
  /// abates de zumbis (total histórico)
  kills     Int      @default(0)
  /// abates de outros jogadores (fogo amigo)
  pvpKills  Int      @default(0) @map("pvp_kills")
  deaths    Int      @default(0)
  /// tempo total conectado, em segundos
  playtimeSeconds Int @default(0) @map("playtime_seconds")
  /// personagem escolhido no lobby (shaun | matt | sam | lis)
  character String   @default("shaun") @db.VarChar(8)
  posX      Float    @default(0) @map("pos_x")
  posZ      Float    @default(0) @map("pos_z")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  sessions   PlayerSession[]
  ownedRooms Room[]        @relation("RoomOwner")
  membership RoomMember?

  @@map("players")
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomStatus {
  LOBBY
  PLAYING
  FINISHED
}

/// Sala de jogo (até MAX_ROOM_PLAYERS). Efêmera: é deletada (com cascade) quando o último membro sai.
model Room {
  id         String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(24)
  visibility RoomVisibility @default(PUBLIC)
  /// código de 4 dígitos exigido para entrar em sala privada
  code       String?        @unique @db.Char(4)
  ownerId    String         @map("owner_id") @db.Uuid
  status     RoomStatus     @default(LOBBY)
  /// dinheiro compartilhado por todos da sala
  money      Int            @default(0)
  /// wave atual da fase (0 = bateria não ativada)
  wave       Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")

  owner   Player       @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members RoomMember[]

  @@map("rooms")
}

/// Jogador dentro de uma sala (um jogador só pode estar em uma sala por vez).
model RoomMember {
  id       String   @id @default(uuid()) @db.Uuid
  roomId   String   @map("room_id") @db.Uuid
  playerId String   @unique @map("player_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_members")
}

/// Uma conexão WebSocket do jogador (auditoria de quem entrou/saiu e quando).
model PlayerSession {
  id             String    @id @default(uuid()) @db.Uuid
  playerId       String    @map("player_id") @db.Uuid
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  /// IP visto pelo servidor (atrás de proxy: X-Forwarded-For)
  ip             String?   @db.VarChar(64)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("player_sessions")
}
